# Production Environment Variables
# Copy this file to .env and fill in all values before deploying

# ── Database ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# Full connection string (used by Prisma)
DATABASE_URL=postgresql://omniweb:change_me_strong_password@localhost:5432/omniweb?schema=public

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@localhost:6379

# ── App ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── CORS (set to your frontend domain in production) ──────────────
CORS_ORIGIN=https://omniweb.yourdomain.com

# ── Webcmd ────────────────────────────────────────────────────────
# Optional: Set a webcmd profile to use for all CLI executions
# WEBCMD_PROFILE=production
